{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoauth.local/schemas/echoauth-sai-binding-record.schema.json",
  "title": "EchoAuth Inert SAI Binding Record",
  "description": "Exact non-authorizing correspondence between one NI-AI transition envelope, its Hawk validation result, and one independently formed EchoAuth authorization request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name", "contract_version", "non_authorizing_status",
    "upstream_repository", "upstream_checkpoint", "schema_path", "schema_blob",
    "transition_id", "correlation_id", "issuer_reference",
    "submitting_actor_reference", "intended_receiver_reference",
    "current_state_reference", "destination_state_reference",
    "state_vocabulary_namespace", "state_vocabulary_version", "state_value",
    "governing_source_reference", "lineage_checkpoint_reference",
    "upstream_scope_reference", "upstream_limits_reference", "valid_from", "valid_until",
    "revocation_reference", "supersession_reference",
    "upstream_evidence_references", "upstream_audit_references",
    "hawk_validation_id", "hawk_transition_id", "hawk_correlation_id",
    "hawk_schema_checkpoint", "hawk_schema_blob", "hawk_validation_state",
    "hawk_disposition", "hawk_continuation_posture", "hawk_authority_excluded",
    "hawk_evidence_references", "hawk_result_hash", "request_id",
    "request_correlation_id", "action", "resource", "request_hash",
    "payload_hash", "context_hash", "policy_version", "idempotency_key",
    "binding_record_id", "forming_component_id", "forming_component_version",
    "formed_at", "expires_at", "nonce", "source_currentness_reference",
    "replay_state_reference", "audit_event_reference", "binding_record_hash"
  ],
  "properties": {
    "contract_name": { "const": "echoauth-sai-binding-record" },
    "contract_version": { "const": "1.0.0" },
    "non_authorizing_status": { "const": "VALID_FOR_INDEPENDENT_ECHOAUTH_AUTHORIZATION_EVALUATION_ONLY" },
    "upstream_repository": { "const": "heliosfi/heliosfi-ni-ai-spine" },
    "upstream_checkpoint": { "$ref": "#/$defs/text" },
    "schema_path": { "const": "schemas/ni-ai-transition-envelope.schema.json" },
    "schema_blob": { "$ref": "#/$defs/text" },
    "transition_id": { "$ref": "#/$defs/text" },
    "correlation_id": { "$ref": "#/$defs/text" },
    "issuer_reference": { "$ref": "#/$defs/text" },
    "submitting_actor_reference": { "$ref": "#/$defs/text" },
    "intended_receiver_reference": { "$ref": "#/$defs/text" },
    "current_state_reference": { "$ref": "#/$defs/text" },
    "destination_state_reference": { "$ref": "#/$defs/text" },
    "state_vocabulary_namespace": { "$ref": "#/$defs/text" },
    "state_vocabulary_version": { "$ref": "#/$defs/text" },
    "state_value": { "$ref": "#/$defs/text" },
    "governing_source_reference": { "$ref": "#/$defs/text" },
    "lineage_checkpoint_reference": { "$ref": "#/$defs/text" },
    "upstream_scope_reference": { "$ref": "#/$defs/text" },
    "upstream_limits_reference": { "$ref": "#/$defs/text" },
    "valid_from": { "$ref": "#/$defs/utc" },
    "valid_until": { "$ref": "#/$defs/utc" },
    "revocation_reference": { "$ref": "#/$defs/text" },
    "supersession_reference": { "$ref": "#/$defs/text" },
    "upstream_evidence_references": { "$ref": "#/$defs/textArray" },
    "upstream_audit_references": { "$ref": "#/$defs/textArray" },
    "hawk_validation_id": { "$ref": "#/$defs/text" },
    "hawk_transition_id": { "$ref": "#/$defs/text" },
    "hawk_correlation_id": { "$ref": "#/$defs/text" },
    "hawk_schema_checkpoint": { "$ref": "#/$defs/text" },
    "hawk_schema_blob": { "$ref": "#/$defs/text" },
    "hawk_validation_state": { "const": "CONFORMANT" },
    "hawk_disposition": { "const": "PROCEED" },
    "hawk_continuation_posture": { "const": "WAIT_FOR_SEPARATE_AUTHORITY" },
    "hawk_authority_excluded": { "$ref": "#/$defs/textArray" },
    "hawk_evidence_references": { "$ref": "#/$defs/textArray" },
    "hawk_result_hash": { "$ref": "#/$defs/hash" },
    "request_id": { "$ref": "#/$defs/text" },
    "request_correlation_id": { "$ref": "#/$defs/text" },
    "action": { "$ref": "#/$defs/text" },
    "resource": { "$ref": "#/$defs/text" },
    "request_hash": { "$ref": "#/$defs/hash" },
    "payload_hash": { "$ref": "#/$defs/hash" },
    "context_hash": { "$ref": "#/$defs/hash" },
    "policy_version": { "$ref": "#/$defs/text" },
    "idempotency_key": { "$ref": "#/$defs/text" },
    "binding_record_id": { "$ref": "#/$defs/text" },
    "forming_component_id": { "const": "echoauth_sai_binding_record_former" },
    "forming_component_version": { "$ref": "#/$defs/text" },
    "formed_at": { "$ref": "#/$defs/utc" },
    "expires_at": { "$ref": "#/$defs/utc" },
    "nonce": { "$ref": "#/$defs/text" },
    "source_currentness_reference": { "$ref": "#/$defs/text" },
    "replay_state_reference": { "$ref": "#/$defs/text" },
    "audit_event_reference": { "$ref": "#/$defs/text" },
    "binding_record_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "textArray": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    }
  }
}
